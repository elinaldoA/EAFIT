{
  "name": "app-react",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs",
    "dev": "vite",
    "site": "node scripts/build-site.mjs",
    "prebuild": "node scripts/copy-ocr.mjs",
    "build": "node scripts/build-site.mjs && vite build && node scripts/build-site.mjs --stamp",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node scripts/test.mjs run",
    "e2e:build": "node scripts/build-e2e.mjs",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:webkit": "npm run e2e:build && playwright test -c playwright.webkit.config.js",
    "build:native": "vite build --mode native",
    "cap:sync": "npm run build:native && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.2",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@supabase/supabase-js": "^2.110.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@zxing/library": "0.23.0",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
